{
  "realm": "e-skylab-test",
  "enabled": true,
  "displayName": "SKY LAB test realm",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr",
    "en"
  ],
  "defaultLocale": "tr",
  "loginTheme": "e-skylab-theme",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@yildizskylab.invalid",
    "fromDisplayName": "SKY LAB test",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "eventsListeners": [
    "jboss-logging",
    "keycloak-to-rabbitmq"
  ],
  "clients": [
    {
      "clientId": "skyapp",
      "name": "SKY LAB Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "com.yildizskylab.skyapp:/oauth/callback"
      ]
    },
    {
      "clientId": "core",
      "name": "SKY LAB core API (fixture)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "skymail",
      "name": "SkyMail (fixture)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://mail.yildizskylab.com/*"
      ]
    },
    {
      "clientId": "skyforms",
      "name": "SKY LAB Forms (fixture)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "rootUrl": "https://forms.yildizskylab.com",
      "redirectUris": [
        "https://forms.yildizskylab.com/api/auth/callback/keycloak"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://forms.yildizskylab.com/",
        "sky.handoff.signInPath": "/auth/signin",
        "sky.handoff.returnParam": "callbackUrl"
      }
    },
    {
      "clientId": "outside-fixture",
      "name": "A site outside yildizskylab.com (fixture)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "rootUrl": "https://example.com",
      "redirectUris": [
        "https://example.com/callback"
      ]
    },
    {
      "clientId": "admin",
      "name": "SKY LAB superadmin (fixture)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "roles": {
    "client": {
      "core": [
        {
          "name": "url:create",
          "description": "fixture client role carried by sky_authorization"
        },
        {
          "name": "url:read",
          "description": "fixture client role not granted to anyone"
        }
      ],
      "skymail": [
        {
          "name": "skymail:access",
          "description": "fixture SkyMail role; skymail:mails:send is created by the harness after the first reconciliation"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "ADMIN",
      "subGroups": [
        {
          "name": "handoff-admin-subgroup-fixture"
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "account-fixture",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Account",
      "lastName": "Fixture",
      "email": "account-fixture@example.invalid",
      "clientRoles": {
        "core": [
          "url:create"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "fixture-password-change-me",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "disabled-account-fixture",
      "enabled": false,
      "emailVerified": true,
      "firstName": "Disabled",
      "lastName": "Fixture",
      "email": "disabled-account-fixture@example.invalid"
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "username": "handoff-admin-fixture",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Handoff",
      "lastName": "Admin",
      "email": "handoff-admin-fixture@example.invalid",
      "groups": [
        "/ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "handoff-admin-password-change-me",
          "temporary": false
        }
      ]
    }
  ]
}
